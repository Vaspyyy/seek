Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set LineHeight 1.25
Set Theme "Catppuccin Mocha"
Set Padding 26
Set Margin 34
Set MarginFill "#b4befe"
Set BorderRadius 12
Set WindowBar Colorful
Set Framerate 24
Set TypingSpeed 55ms
Hide
Type "export HOME=/var/tmp/seek-demo/home COLORTERM=truecolor TERM=xterm-256color PS1='\[\e[38;2;203;166;247m\]❯\[\e[0m\] ' && cd ~/projects && clear"
Enter
Sleep 300ms
Show
